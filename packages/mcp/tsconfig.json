{
  // TypeScript sources, no build step, like @xbase/ai: the web app bundles them into its server
  // and type checks them with its own tsconfig. Server-only: Node's types, and DOM for fetch,
  // Request and Response.
  "include": ["src", "vitest.config.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  }
}
