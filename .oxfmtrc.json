{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "sortImports": {
    "newlinesBetween": false
  },
  "sortTailwindcss": {
    "functions": ["cn", "cva", "clsx", "tv"]
  },
  // Class order depends on each app's theme, so each app points at its own entry stylesheet.
  // A wrong path turns sorting off without an error.
  "overrides": [
    {
      "files": ["apps/web/**"],
      "options": {
        "sortTailwindcss": { "stylesheet": "./apps/web/src/styles.css" }
      }
    },
    {
      "files": ["apps/extension/**"],
      "options": {
        "sortTailwindcss": { "stylesheet": "./apps/extension/src/assets/tailwind.css" }
      }
    }
  ],
  // Generated by TanStack Router on every dev and build run.
  "ignorePatterns": ["**/routeTree.gen.ts"]
}
