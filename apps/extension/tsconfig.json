{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // `paths` replaces WXT's generated aliases, so @/* is declared again. @xbase/ui's BoardUI
    // sources import each other through their alias (see packages/ui).
    "paths": { "@/*": ["./src/*"], "@xbase/ui/*": ["../../packages/ui/*"] }
  }
}
