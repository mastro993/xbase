# Copy to .env (git-ignored) and fill in. `pnpm dev` and `pnpm start` read it from this folder;
# in Docker, pass the variables to the container instead (see compose.yaml).

# Required. The OAuth 2.0 Client ID and Client Secret of your own X app (developer.x.com, under
# the app's "Keys and tokens"). Signing in to XBase goes through it; see "Set up your X app" in
# README.md for the callback URL to register.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional. The only X account that may claim this XBase while it has none, e.g. @you. Without it,
# the first X account to sign in owns it.
# X_OWNER_USERNAME=

# The public address people and MCP clients use, as an origin: scheme, host and port, no path.
# Required for a production build; `pnpm dev` defaults to http://127.0.0.1:5173 (X refuses
# localhost callbacks). When 5173 is taken `pnpm dev` prints another port: set this to it, and add
# its /auth/x/callback to your X app, to sign in there. HTTPS turns on Secure cookies, and MCP
# clients only connect over HTTPS (or to localhost).
# APP_URL=https://xbase.example.com

# Optional. API keys of the AI providers XBase may use to refine drafts: Settings offers each
# provider that has one. Without any, AI writing is off.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=

# Optional. A TypeSafe key for Jev, the decision model (it answers questions with probabilities
# rather than writing text). Settings picks the model.
# TYPESAFE_API_KEY=

# Where the SQLite database lives. Default: ./data/xbase.db (relative to this folder).
# DATABASE_PATH=./data/xbase.db

# The port of the production server (`pnpm start`). Default: 3000. `pnpm dev` prefers 5173, then
# moves to the next free port.
# PORT=3000

# Behind reverse proxies, how many of them add the visitor's address to X-Forwarded-For, so the
# MCP rate limits count each visitor on their own: 1 for Caddy, nginx or cloudflared.
# Default: 0, which ignores the header: keep it when nothing sits in front of XBase, since any
# visitor can write it. See "Behind a reverse proxy" in README.md.
# TRUST_PROXY_HOPS=1
