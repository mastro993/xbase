# Copy to .env (git-ignored) and fill in. `pnpm dev` and `pnpm start` read it from this folder;
# in Docker, pass the variables to the container instead (see compose.yaml).

# Required. The only way into XBase: at least 12 characters. Use a long random one, for example
# from `openssl rand -base64 24`.
APP_PASSWORD=

# The public address people and MCP clients use, as an origin: scheme, host and port, no path.
# Required for a production build; `pnpm dev` defaults to http://localhost:5173.
# HTTPS turns on Secure cookies, and MCP clients only connect over HTTPS (or to localhost).
# APP_URL=https://xbase.example.com

# Where the SQLite database lives. Default: ./data/xbase.db (relative to this folder).
# DATABASE_PATH=./data/xbase.db

# The port of the production server (`pnpm start`). Default: 3000. `pnpm dev` uses 5173.
# PORT=3000

# Behind reverse proxies, how many of them add the visitor's address to X-Forwarded-For, so the
# sign-in and MCP rate limits count each visitor on their own: 1 for Caddy, nginx or cloudflared.
# Default: 0, which ignores the header: keep it when nothing sits in front of XBase, since any
# visitor can write it. See "Behind a reverse proxy" in README.md.
# TRUST_PROXY_HOPS=1
